# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Coordonnées bancaires imprimées sur les factures (serveur uniquement, jamais NEXT_PUBLIC_)
ADMIN_IBAN=
ADMIN_BIC=
ADMIN_TITULAIRE=
ADMIN_BANQUE=

# Ping anti-pause Supabase (Vercel envoie ce secret aux crons)
CRON_SECRET=

# Sauvegarde locale uniquement (npm run backup) — jamais sur Vercel
SUPABASE_SERVICE_ROLE_KEY=
